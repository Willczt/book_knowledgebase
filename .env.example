# ============================
# 数据库
# ============================
# 开发环境（SQLite，零配置）
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
# 生产环境（PostgreSQL，需取消注释）
# DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key  # 仅 Qdrant Cloud 使用

# ============================
# 文件存储
# ============================
STORAGE_ROOT=./storage  # 存储上传文件和提取图片的根目录

# ============================
# 后台任务
# ============================
# 摄入任务跑在进程内，服务重启后任务丢失；启动时把遗留的 pending/processing 文档标记为 failed
CLEANUP_STALE_DOCUMENTS=true
# 心跳超过该秒数未更新视为任务已死（多 worker 下靠 PID + 心跳区分，不会误杀别人的任务）
STALE_TASK_GRACE_SECONDS=300
# 摄入任务心跳写盘间隔（秒）
TASK_HEARTBEAT_INTERVAL=15

# ============================
# Doubao / 火山引擎 Ark
# ============================
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-2-0-lite-260428
# doubao-embedding-vision-251215 同时支持纯文本和图片，推荐统一使用
DOUBAO_TEXT_EMBEDDING_MODEL=doubao-embedding-vision-251215
DOUBAO_VISION_EMBEDDING_MODEL=doubao-embedding-vision-251215
DOUBAO_VISION_CHAT_MODEL=doubao-seed-2-0-lite-260428

# ============================
# DeepSeek
# ============================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================
# Ollama（本地）
# ============================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_CHAT_MODEL=llama3
OLLAMA_DEFAULT_EMBED_MODEL=nomic-embed-text

# ============================
# vLLM（本地）
# ============================
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=EMPTY  # vLLM 默认使用 EMPTY

# ============================
# LLM 生成参数
# ============================
# 推理模型（deepseek-flash 等）的思考过程也计入 max_tokens，太小会只思考不出正文
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
# 推理强度 low/high/max（推理模型才支持，low 更快；留空用服务端默认）
# LLM_REASONING_EFFORT=low

# ============================
# 多轮对话
# ============================
# 追问（"二者矛盾在哪"）检索前改写成独立问题：llm | concat | off
QUERY_REWRITE=llm
QUERY_REWRITE_MAX_TOKENS=2048

# ============================
# RAG 默认参数
# ============================
DEFAULT_TOP_K=8
CONTEXT_HISTORY_TURNS=10
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_IMAGE_DIMENSION=1024

# ============================
# 网络超时（秒）
# ============================
# embedding 批量请求超时（本地 ollama 大 batch 可能较慢）
EMBEDDING_TIMEOUT=120
# 单张图片 caption 超时
CAPTION_TIMEOUT=60

# ============================
# 图片描述（多模态 caption）
# ============================
# 显式指定时优先；留空则按 豆包 → DeepSeek → Ollama 自动选择
# deepseek-flash (V4.1-Flash) 支持图像输入，无需本地视觉模型
CAPTION_PROVIDER=deepseek
CAPTION_MODEL_ID=deepseek-flash
# 推理模型的思考也计入该上限，太小会只有思考没有描述
CAPTION_MAX_TOKENS=2048
# 并发 caption 请求数
CAPTION_CONCURRENCY=5
# Ollama 本地视觉模型（换成本地模型时使用，如 qwen2.5vl、gemma3）
OLLAMA_VISION_MODEL=llava

# ============================
# 跨域（CORS）
# ============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
