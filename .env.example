# ============================
# 数据库
# ============================
# 开发环境（SQLite，零配置）
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
# 生产环境（PostgreSQL，需取消注释）
# DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key  # 仅 Qdrant Cloud 使用

# ============================
# 文件存储
# ============================
STORAGE_ROOT=./storage  # 存储上传文件和提取图片的根目录

# ============================
# Doubao / 火山引擎 Ark
# ============================
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_CHAT_MODEL=doubao-seed-2-0-lite-260428
# doubao-embedding-vision-251215 同时支持纯文本和图片，推荐统一使用
DOUBAO_TEXT_EMBEDDING_MODEL=doubao-embedding-vision-251215
DOUBAO_VISION_EMBEDDING_MODEL=doubao-embedding-vision-251215
DOUBAO_VISION_CHAT_MODEL=doubao-seed-2-0-lite-260428

# ============================
# DeepSeek
# ============================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================
# Ollama（本地）
# ============================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_CHAT_MODEL=llama3
OLLAMA_DEFAULT_EMBED_MODEL=nomic-embed-text

# ============================
# vLLM（本地）
# ============================
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=EMPTY  # vLLM 默认使用 EMPTY

# ============================
# RAG 默认参数
# ============================
DEFAULT_TOP_K=8
CONTEXT_HISTORY_TURNS=10
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_IMAGE_DIMENSION=1024

# ============================
# 跨域（CORS）
# ============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
