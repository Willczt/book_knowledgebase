# ============================
# 数据库
# ============================
# 开发环境（SQLite，零配置）
DATABASE_URL=sqlite+aiosqlite:///./storage/app.db
# 生产环境（PostgreSQL，需取消注释）
# DATABASE_URL=postgresql+asyncpg://bookrag:bookrag@localhost:5432/bookrag

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key  # 仅 Qdrant Cloud 使用

# ============================
# 文件存储
# ============================
STORAGE_ROOT=./storage  # 存储上传文件和提取图片的根目录

# ============================
# 后台任务（DB 队列 + 进程内 worker）
# ============================
# 同时进行的摄入任务数；Ollama 单卡建议 1~2，远程 API 可调大
INGEST_WORKERS=2
# 失败重试次数（含首次），超过后文档落 failed
INGEST_MAX_ATTEMPTS=3
# 任务租约（秒）：超时未续租视为 worker 已死，文档自动回到队列
INGEST_LEASE_SECONDS=1800
# 续租间隔（秒）
INGEST_LEASE_RENEW_SECONDS=60
# 关闭时等待在跑任务收尾的时间（与 compose 的 stop_grace_period 配合）
SHUTDOWN_GRACE_SECONDS=30
# 队列空闲轮询间隔（秒），用于 next_retry_at 到期的重试
INGEST_POLL_SECONDS=2.0

# ============================
# 日志与鉴权
# ============================
# console（开发可读）| json（生产，便于采集）
LOG_FORMAT=console
LOG_LEVEL=INFO
# 可选：设置后所有 /api/* 请求需带 Authorization: Bearer <token>
# 前端构建时用 VITE_API_TOKEN 注入同一个值
# API_TOKEN=

# ============================
# 数据库连接池（仅 PostgreSQL 生效）
# ============================
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ============================
# 导入包限制（防 zip bomb）
# ============================
IMPORT_MAX_ENTRIES=20000
IMPORT_MAX_UNCOMPRESSED_BYTES=8589934592

# 可选 provider：豆包（火山 Ark）。不配置 ARK_API_KEY 时不会注册该 provider，
# 模型名走 config.py 里的默认值；需要启用时再取消注释。
# ARK_API_KEY=

# ============================
# DeepSeek
# ============================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================
# Ollama（本地）
# ============================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_CHAT_MODEL=llama3
OLLAMA_DEFAULT_EMBED_MODEL=nomic-embed-text

# ============================
# vLLM（本地）
# ============================
# VLLM_BASE_URL=http://localhost:8000
# VLLM_API_KEY=EMPTY  # vLLM 默认使用 EMPTY

# ============================
# LLM 生成参数
# ============================
# 推理模型（deepseek-flash 等）的思考过程也计入 max_tokens，太小会只思考不出正文
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=120
# 推理强度 low/high/max（推理模型才支持，low 更快；留空用服务端默认）
# LLM_REASONING_EFFORT=low

# ============================
# LLM 兜底（本地模型失败时切到在线模型）
# ============================
# 只对本地 provider（ollama / vllm）生效：吐第一个 token 前失败就切换
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_PROVIDER=deepseek
# 留空则用该 provider 的默认对话模型（deepseek -> DEEPSEEK_MODEL）
# LLM_FALLBACK_MODEL=deepseek-flash

# ============================
# 多轮对话
# ============================
# 追问（"二者矛盾在哪"）检索前改写成独立问题：llm | concat | off
QUERY_REWRITE=llm
QUERY_REWRITE_MAX_TOKENS=2048

# ============================
# RAG 默认参数
# ============================
DEFAULT_TOP_K=8
CONTEXT_HISTORY_TURNS=10
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_IMAGE_DIMENSION=1024

# ============================
# Rerank 重排序（检索结果二次排序）
# ============================
# 默认开启；界面上每个请求也可以单独关掉
RERANK_ENABLED=true
# http = vLLM cross-encoder 的 /v1/rerank 接口；flashrank = 本地 ONNX 模型
RERANK_BACKEND=http
# 启动方式示例（推荐用项目统一管理：make rerank-up）：
#   vllm serve BAAI/bge-reranker-v2-m3 --port 8100
# 若 vLLM 与 embedding 共用端口，填同一个 base_url 即可
# WSL 提示：mirrored 网络下 127.0.0.1 的转发可能不稳定（连接被拒），
# 此时把 host 换成本机 IP（hostname -I 查看），例如 http://192.168.1.20:8100/v1
RERANK_BASE_URL=http://localhost:8100/v1
# RERANK_API_KEY=EMPTY
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 参与精排的候选数（应 >= 最终 top_k）
RERANK_CANDIDATES=30
RERANK_TIMEOUT=30
# flashrank 后端使用的本地模型（英文场景可用）
RERANK_LOCAL_MODEL=ms-marco-MiniLM-L-6-v2

# ============================
# 网络超时（秒）
# ============================
# embedding 批量请求超时（本地 ollama 大 batch 可能较慢）
EMBEDDING_TIMEOUT=120
# 单张图片 caption 超时
CAPTION_TIMEOUT=60

# ============================
# 图片描述（多模态 caption）
# ============================
# 显式指定时优先；留空则按已配置的 provider 自动选择（DeepSeek → Ollama）
# deepseek-flash (V4.1-Flash) 支持图像输入，无需本地视觉模型
CAPTION_PROVIDER=deepseek
CAPTION_MODEL_ID=deepseek-flash
# 推理模型的思考也计入该上限，太小会只有思考没有描述
CAPTION_MAX_TOKENS=2048
# 并发 caption 请求数
CAPTION_CONCURRENCY=5
# Ollama 本地视觉模型（换成本地模型时使用，如 qwen2.5vl、gemma3）
OLLAMA_VISION_MODEL=llava

# ============================
# 跨域（CORS）
# ============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
